{
  "name": "ioredis-toolkit",
  "version": "0.0.1",
  "description": "Production-grade, type-safe Redis infrastructure for standalone, Sentinel, and Cluster deployments",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js"
    },
    "./pubsub": {
      "types": "./dist/pubsub.d.ts",
      "import": "./dist/pubsub.js"
    },
    "./lock": {
      "types": "./dist/lock.d.ts",
      "import": "./dist/lock.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "import": "./dist/health.js"
    },
    "./ratelimiter": {
      "types": "./dist/ratelimiter.d.ts",
      "import": "./dist/ratelimiter.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/org-utils/ioredis-toolkit.git"
  },
  "homepage": "https://github.com/org-utils/ioredis-toolkit#readme",
  "bugs": {
    "url": "https://github.com/org-utils/ioredis-toolkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write 'src/**/*.ts'",
    "clean:git": "git clean -xdf",
    "changeset:init": "changeset init",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish",
    "release": "npm run build && changeset publish",
    "prebuild": "npm run typecheck",
    "test:unit": "vitest run test/cluster-slot.test.ts test/config.test.ts test/client.test.ts test/cache.test.ts test/ratelimiter.test.ts"
  },
  "keywords": [
    "redis",
    "cluster",
    "sentinel",
    "distributed",
    "cache",
    "pubsub",
    "locking"
  ],
  "author": "Your Organization",
  "license": "MIT",
  "dependencies": {
    "ioredis": "^5.11.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
